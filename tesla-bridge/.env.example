# Tesla Fleet API
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_API_BASE=https://fleet-api.prd.eu.vn.cloud.tesla.com

# Public API origin (browser OAuth + JSON API)
PUBLIC_BASE_URL=https://api.example.com
FRONTEND_ORIGIN=https://teslamap.github.io
API_DOMAIN=api.example.com

# Fleet Telemetry public hostname/port.
# Put this hostname in the Fleet Telemetry vehicle configuration.
TELEMETRY_DOMAIN=telemetry.example.com
TELEMETRY_PORT=8443

# Database / Redis
DATABASE_URL=
REDIS_URL=redis://redis:6379
DATA_DIR=/app/data

# Paste the PEM public key here only if using the app endpoint.
# Keep private-key.pem OUTSIDE Git.
TESLA_PUBLIC_KEY=

# Never commit real secrets or private keys.
